<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-S04: nothing of the app is copied to cloud backup or device transfer. The vault is
     encrypted, but it must still not leave the device through the OS backup channels. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
